DATAPILOT_ALLOWED_ORIGINS=http://localhost:3000
DATAPILOT_DATA_DIR=.data
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI layer (spec §5). auto = Anthropic when the SDK resolves credentials, else deterministic;
# off = deterministic; replay = deterministic labelled verified-replay (tests, golden generation).
DATAPILOT_AI_MODE=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Response cache: fallback (live first, cache on failure) | prefer (cache first) | off
DATAPILOT_AI_CACHE=fallback
# Reachability is an environment concern; the SDK honours both of these when set.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# HTTPS_PROXY=http://127.0.0.1:7890
