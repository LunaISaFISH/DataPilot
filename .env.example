DATAPILOT_ALLOWED_ORIGINS=http://localhost:3000
DATAPILOT_DATA_DIR=.data
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public booth runtime. Keep PUBLIC_MODE off for ordinary local development.
DATAPILOT_PUBLIC_MODE=0
DATAPILOT_UPLOADS_PER_MINUTE=10
DATAPILOT_AI_REQUESTS_PER_HOUR=20
DATAPILOT_AI_DAILY_CALL_CAP=40
DATAPILOT_RUN_RETENTION_HOURS=24
DATAPILOT_SEED_SAMPLES=0

# AI layer (spec §5). auto = Anthropic when the SDK resolves credentials, else deterministic;
# off = deterministic; replay = deterministic labelled verified-replay (tests, golden generation).
DATAPILOT_AI_MODE=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Response cache: fallback (live first, cache on failure) | prefer (cache first) | off
DATAPILOT_AI_CACHE=fallback
# Reachability is an environment concern; the SDK honours both of these when set.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# HTTPS_PROXY=http://127.0.0.1:7890
