FROM python:3.12-slim

# Runtime configuration is passed through the environment at `docker run` / compose time.
# No secrets are baked into the image: ANTHROPIC_API_KEY is intentionally absent here.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATAPILOT_DATA_DIR=/var/lib/datapilot \
    DATAPILOT_AI_MODE=auto \
    DATAPILOT_AI_CACHE=fallback \
    DATAPILOT_DOCS=0 \
    ANTHROPIC_MODEL=claude-haiku-4-5-20251001

WORKDIR /app
COPY pyproject.toml README.md ./
COPY services/api ./services/api
COPY fixtures ./fixtures
RUN pip install --no-cache-dir .

RUN useradd --create-home --uid 10001 datapilot \
    && mkdir -p /var/lib/datapilot \
    && chown datapilot:datapilot /var/lib/datapilot
USER datapilot

EXPOSE 8000
CMD ["uvicorn", "datapilot.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
